<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<style>
.tblGrid {
  border-collapse: collapse;   /* makes one continuous grid */
  width: 100%;
}

.tblGrid td {
  border: 1px solid #000;      /* vertical + horizontal lines */
  padding: 10px;               /* spacing inside each cell */
  text-align: left;
}

.tblHeader td {
  background-color: #f2f2f2;   /* header shading */
  font-weight: bold;
}

</style>
</head>
<body>
<table class="tblGrid">
  <tr class="tblHeader tblBorder">
    <td></td>
    <td><b>Name</b></td>
    <td><b>Medicaid ID</b></td>
    <td><b>City</b></td>
    <td><b>SSN</b></td>
  </tr>
  <tr class="tblBorder">
    <td>1</td>
    <td>John Doe</td>
    <td>123456</td>
    <td>New York</td>
    <td>111-22-3333</td>
  </tr>
  <tr class="tblBorder">
    <td>2</td>
    <td>Jane Smith</td>
    <td>654321</td>
    <td>Chicago</td>
    <td>444-55-6666</td>
  </tr>
</table>


</body>
</html>